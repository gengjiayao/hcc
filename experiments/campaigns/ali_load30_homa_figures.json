{
  "schema_version": 1,
  "name": "ali-load30-guard-hpcc-homa-figures",
  "purpose": "Replace the initial 30-percent AliStorage slowdown panels with actual GUARD, HPCC, and qualified Homa ns-3 runs.",
  "selection_policy": "Freeze five traces before ns-3, admit the three seed-1 protocol mechanisms without inspecting performance, and expand seeds 2-5 only after the gate passes.",
  "seeds": [1, 2, 3, 4, 5],
  "limits": {
    "max_flows": 10000,
    "run_bytes": 104857600,
    "campaign_bytes": 1073741824,
    "run_timeout_seconds": 1800
  },
  "defaults": {
    "topo": "leaf_spine_8_100G_OS2",
    "hosts": 8,
    "oversubscription": 2,
    "simul_time": 0.01,
    "netload": 30,
    "bw": 100,
    "priority_group": 3,
    "analysis_warmup": 0.005,
    "buffer": 9,
    "lb": "fecmp",
    "pfc": 1,
    "irn": 0,
    "monitor_profile": "bulk",
    "guard_lambda": 1.4,
    "guard_beta": 0.125,
    "guard_gamma": 1.0,
    "guard_selective_registration": 1,
    "guard_proactive_release": 1,
    "guard_keep_last_hop_int": 0,
    "guard_rebalance_interval_us": 200,
    "guard_demand_threshold": 0.75,
    "guard_receiver_util_threshold": 0.75,
    "homa_resend_timeout_us": 1000
  },
  "admission": {
    "seed": 1,
    "controller_trace_arm": "guard",
    "full_controller_trace": true,
    "full_controller_max_lines": 300000,
    "require_complete": true,
    "require_zero_drop_recovery": true,
    "guard": "grants, valid HPCC feedback, actual rate changes, reactive binding, and sender SRPT activity are nonzero",
    "hpcc": "GUARD grants are zero and valid HPCC feedback/rate changes are nonzero",
    "homa": "native DATA/grants, exact completion/tombstone accounting, pending state, and at least two DATA priorities are exercised"
  },
  "arms": {
    "guard": {
      "cc": "guard",
      "guard_size_priority": 1,
      "guard_sender_srpt": 1,
      "guard_srpt_quantum_packets": 64,
      "guard_work_conserving": 1
    },
    "hpcc": {"cc": "hpcc"},
    "homa": {"cc": "homa"}
  },
  "workloads": [
    {"name": "AliStorage30", "cdf": "AliStorage2019"}
  ],
  "flow_size_buckets": [
    {"name": "le_8KB", "max_bytes": 8192},
    {"name": "8KB_to_1BDP", "min_exclusive_bytes": 8192, "max_bytes": 104000},
    {"name": "1BDP_to_1MB", "min_exclusive_bytes": 104000, "max_bytes": 1048576},
    {"name": "gt_1MB", "min_exclusive_bytes": 1048576}
  ],
  "comparisons": [
    ["guard", "hpcc"],
    ["guard", "homa"],
    ["homa", "hpcc"]
  ]
}
