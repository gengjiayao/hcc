  "selection": {
    "baseline_arm": "eta000_rho100_q64",
    "primary_metric": "gt_1MB_fct_us_mean",
    "require_primary_paired_percent_ci95_high_below": 0.0,
    "constraints": {
      "overall_fct_us_mean": 1.0,
      "le_8KB_slowdown_p95": 1.0,
