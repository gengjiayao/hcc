{
  "schema_version": 1,
  "name": "guard-parameter-search-stage1",
  "purpose": "Improve GUARD's high-load elephant latency by tuning the receiver minimum share and remaining-size exponent before changing the algorithm.",
  "selection_policy": "The complete 3x3 eta/rho grid, constraints, metric order, and seeds are frozen before preflight. Seed 26 is inspected only for mechanism admission. All admitted seeds 26-30 enter the paired analysis; no seed or grid point may be removed because of its performance direction.",
  "seeds": [26, 27, 28, 29, 30],
  "limits": {
    "max_flows": 10000,
    "run_bytes": 104857600,
    "campaign_bytes": 1073741824,
    "run_timeout_seconds": 1800
  },
  "defaults": {
    "topo": "leaf_spine_8_100G_OS2",
    "hosts": 8,
    "oversubscription": 2,
    "simul_time": 0.01,
    "netload": 50,
    "bw": 100,
    "priority_group": 3,
    "analysis_warmup": 0.005,
    "buffer": 9,
    "lb": "fecmp",
    "pfc": 1,
    "irn": 0,
    "monitor_profile": "bulk",
    "guard_lambda": 1.8,
    "guard_beta": 0.125,
    "guard_gamma": 1.0,
    "guard_selective_registration": 1,
    "guard_proactive_release": 1,
    "guard_keep_last_hop_int": 0,
    "guard_size_priority": 1,
    "guard_sender_srpt": 1,
    "guard_srpt_quantum_packets": 64,
    "guard_one_rtt_bypass": 1,
    "guard_tail_bypass": 1,
    "guard_tail_bypass_bdps": 8.0,
    "guard_ack_interval_packets": 8,
    "guard_fixed_window": 1,
    "guard_remaining_aware": 1,
    "guard_grant_refresh_bdps": 1.0,
    "guard_work_conserving": 0,
    "guard_rebalance_interval_us": 200,
