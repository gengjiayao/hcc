    "eta000_rho075_q64": {"cc": "guard", "guard_min_share_fraction": 0.0, "guard_remaining_exponent": 0.75},
    "eta000_rho050_q64": {"cc": "guard", "guard_min_share_fraction": 0.0, "guard_remaining_exponent": 0.5},
    "eta010_rho100_q64": {"cc": "guard", "guard_min_share_fraction": 0.1, "guard_remaining_exponent": 1.0},
    "eta010_rho075_q64": {"cc": "guard", "guard_min_share_fraction": 0.1, "guard_remaining_exponent": 0.75},
    "eta010_rho050_q64": {"cc": "guard", "guard_min_share_fraction": 0.1, "guard_remaining_exponent": 0.5},
    "eta020_rho100_q64": {"cc": "guard", "guard_min_share_fraction": 0.2, "guard_remaining_exponent": 1.0},
    "eta020_rho075_q64": {"cc": "guard", "guard_min_share_fraction": 0.2, "guard_remaining_exponent": 0.75},
    "eta020_rho050_q64": {"cc": "guard", "guard_min_share_fraction": 0.2, "guard_remaining_exponent": 0.5}
