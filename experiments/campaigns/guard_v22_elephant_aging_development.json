{
  "schema_version": 1,
  "name": "guard-v22-elephant-aging-development",
  "purpose": "Fresh paired development test of bounded fixed-K elephant aging against the V19 K=1 baseline.",
  "development_only": true,
  "mechanism_profile": "V22",
  "selection_policy": "Controller diagnostics on the V19/V21 workload found that the remaining GUARD-versus-Homa long-flow gap coincides with individual greater-than-12-path-BDP elephants spending tens of microseconds at the 100-Mb/s deferred floor. V20 showed that simultaneous K=2 service raises queues, so V22 keeps K=1 and the same total receiver allocation. A deferred elephant waiting two of its own base RTTs replaces the shortest elephant for one canonical frozen-vector quantum; all other elephants retain the same floor. The two-RTT threshold is frozen before seeds 180--184. Compare against V19 K=1 on matched traffic, admit seed 180 on mechanisms only, open performance only after all ten cells pass, and retain every seed and direction. A selected aging arm still requires an independent GUARD/HPCC/Homa holdout.",
  "seeds": [180, 181, 182, 183, 184],
  "limits": {"max_flows": 10000, "run_bytes": 104857600, "campaign_bytes": 1073741824, "run_timeout_seconds": 1800},
  "defaults": {
    "topo": "leaf_spine_8_100G_OS2", "hosts": 8, "oversubscription": 2,
    "simul_time": 0.01, "netload": 50, "bw": 100, "priority_group": 3,
    "analysis_warmup": 0.005, "buffer": 9, "lb": "fecmp", "pfc": 1,
    "irn": 0, "monitor_profile": "bulk",
    "guard_lambda": 1.8, "guard_beta": 0.125, "guard_gamma": 1.0,
    "guard_selective_registration": 1, "guard_proactive_release": 1,
    "guard_keep_last_hop_int": 0, "guard_size_priority": 1,
    "guard_sender_srpt": 1, "guard_one_rtt_bypass": 1,
    "guard_tail_bypass": 1, "guard_tail_bypass_bdps": 8.0,
    "guard_tail_congestion_gate": 0, "guard_tail_safe_ratio": 0.9,
    "guard_tail_safe_samples": 2, "guard_adaptive_fabric_target": 0,
    "guard_target_floor": 0.95, "guard_queue_budget_bdps": 0.5,
    "guard_adaptive_target_max_bdps": 0.0, "guard_ack_interval_packets": 8,
    "guard_fixed_window": 1, "guard_remaining_aware": 1,
    "guard_min_share_fraction": 0.0, "guard_remaining_exponent": 1.0,
    "guard_receiver_concurrency": 1,
    "guard_adaptive_elephant_concurrency": 0,
    "guard_elephant_aging_rtts": 0.0,
    "guard_concurrency_min_bdps": 12.0,
    "guard_grant_refresh_bdps": 1.0, "guard_membership_coalesce_ns": 12480,
    "guard_membership_coalesce_max_windows": 5,
    "guard_initial_collection_quiet_ns": 16640,
    "guard_initial_collection_full_deadline": 0,
    "guard_small_set_fastpath_limit": 4, "guard_transition_prefix_barrier": 1,
    "guard_transition_prefix_wire_watchdog": 1,
    "guard_transition_prefix_fail_closed": 0,
    "guard_transition_prefix_ack_clock_fallback": 1,
    "guard_mixed_pg_vector_fastpath": 1,
    "guard_serialized_progress_refresh": 1, "guard_serialized_draining": 1,
    "guard_capacity_admission_deferral": 1,
    "guard_grant_reliability_rtts": 2.0, "guard_srpt_quantum_packets": 64,
    "guard_work_conserving": 0, "guard_cap_aware_reclaim": 0,
    "guard_cap_headroom": 1.1, "guard_cap_min_share_fraction": 0.25,
    "guard_rebalance_interval_us": 200, "guard_demand_threshold": 0.75,
    "guard_receiver_util_threshold": 0.75
  },
  "admission": {
    "seed": 180, "controller_trace_arm": "none",
    "full_controller_trace": false, "full_controller_max_lines": 300000,
    "require_complete": true, "require_zero_drop_recovery": true
  },
  "arms": {
    "guard_k1": {
      "cc": "guard", "guard_receiver_concurrency": 1,
      "guard_elephant_aging_rtts": 0.0
    },
    "guard_aging": {
      "cc": "guard", "guard_receiver_concurrency": 1,
      "guard_elephant_aging_rtts": 2.0
    }
  },
  "workloads": [{"name": "AliStorage50", "cdf": "AliStorage2019"}],
  "flow_size_buckets": [
    {"name": "le_8KB", "max_bytes": 8192},
    {"name": "8KB_to_1BDP", "min_exclusive_bytes": 8192, "max_bytes": 104000},
    {"name": "1BDP_to_1MB", "min_exclusive_bytes": 104000, "max_bytes": 1048576},
    {"name": "gt_1MB", "min_exclusive_bytes": 1048576}
  ],
  "comparisons": [["guard_aging", "guard_k1"]],
  "selection": {
    "baseline_arm": "guard_k1",
    "candidate_arm": "guard_aging",
    "require_gt_1MB_fct_us_mean_percent_ci95_high_at_most": -1.0,
    "require_gt_1MB_fct_us_p95_percent_ci95_high_at_most": 0.0,
    "require_overall_fct_us_mean_percent_ci95_high_at_most": 0.0,
    "require_le_8KB_fct_us_p95_percent_ci95_high_at_most": 0.5,
    "require_queue_mean_bytes_percent_ci95_high_at_most": 5.0,
    "require_queue_p99_bytes_percent_ci95_high_at_most": 5.0,
    "require_overall_flow_goodput_jain_difference_ci95_low_at_least": -0.005,
    "selected_candidate_requires_fresh_three_arm_holdout": true
  }
}
