{
  "schema_version": 1,
  "name": "general-workloads-formal",
  "purpose": "A preflight-gated, matched-flow comparison of full GUARD, HPCC, and receiver-only GUARD across published datacenter workload CDFs.",
  "selection_policy": "Generate all five traces before ns-3. Exclude a workload if its frozen flow-count rule fails. Run only seed 1 for mechanism admission; run seeds 2-5 only after all three seed-1 arms pass without inspecting performance direction.",
  "seeds": [1, 2, 3, 4, 5],
  "limits": {
    "max_flows": 10000,
    "run_bytes": 104857600,
    "campaign_bytes": 2147483648,
    "run_timeout_seconds": 1800
  },
  "defaults": {
    "topo": "leaf_spine_16_100G_OS4",
    "hosts": 16,
    "oversubscription": 4,
    "simul_time": 0.02,
    "netload": 40,
    "bw": 100,
    "priority_group": 3,
    "analysis_warmup": 0.005,
    "buffer": 9,
    "lb": "fecmp",
    "pfc": 1,
    "irn": 0,
    "monitor_profile": "bulk",
    "guard_lambda": 1.0,
    "guard_beta": 0.125,
    "guard_gamma": 1.0,
    "guard_selective_registration": 1,
    "guard_proactive_release": 1,
    "guard_keep_last_hop_int": 0,
    "guard_size_priority": 0
  },
  "admission": {
    "seed": 1,
    "full_controller_trace": true,
    "full_controller_max_lines": 300000,
    "require_complete": true,
    "require_zero_drop_recovery": true,
    "full": "grants_sent > 0, hpcc_valid_feedback > 0, hpcc_actual_rate_changes > 0, reactive_binding_updates > 0",
    "hpcc": "grants_sent + grants_received == 0, hpcc_valid_feedback > 0, hpcc_actual_rate_changes > 0",
    "receiver": "grants_sent > 0 and all HPCC counters == 0"
  },
  "arms": {
    "full": {"cc": "guard", "guard_size_priority": 0},
    "hpcc": {"cc": "hpcc"},
    "receiver": {"cc": "guard-active-only", "guard_size_priority": 0}
  },
  "workloads": [
    {"name": "AliStorage2019", "cdf": "AliStorage2019"},
    {"name": "WebSearch", "cdf": "WebSearch"},
    {"name": "FbHdp", "cdf": "FbHdp2015"},
    {
      "name": "GoogleRPC",
      "cdf": "GoogleRPC2008",
      "fallback": {
        "topo": "leaf_spine_8_100G_OS1",
        "hosts": 8,
        "oversubscription": 1,
        "simul_time": 0.01,
        "netload": 20
      }
    }
  ],
  "flow_size_buckets": [
    {"name": "le_8KB", "max_bytes": 8192},
    {"name": "8KB_to_1BDP", "min_exclusive_bytes": 8192, "max_bytes": 104000},
    {"name": "1BDP_to_1MB", "min_exclusive_bytes": 104000, "max_bytes": 1048576},
    {"name": "gt_1MB", "min_exclusive_bytes": 1048576}
  ],
  "comparisons": [
    ["full", "hpcc"],
    ["full", "receiver"],
    ["receiver", "hpcc"]
  ]
}
